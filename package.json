{
  "name": "ewm-apps",
  "version": "0.1.0",
  "description": "Event Waste Management - Contract Implementation and Conformance Testing",
  "main": "service/src/app.js",
  "scripts": {
    "test:contract": "OIDC_ISSUER=https://test.local/ OIDC_AUDIENCE=eventwise-api OIDC_JWKS_URI=http://127.0.0.1:9999/jwks.json node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/contract --runInBand --verbose",
    "test:helpers": "OIDC_ISSUER=https://test.local/ OIDC_AUDIENCE=eventwise-api OIDC_JWKS_URI=http://127.0.0.1:9999/jwks.json node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/helpers --runInBand --verbose",
    "test:authz": "OIDC_ISSUER=https://test.local/ OIDC_AUDIENCE=eventwise-api OIDC_JWKS_URI=http://127.0.0.1:9999/jwks.json node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/authz --runInBand --verbose",
    "test:e2e": "OIDC_ISSUER=https://test.local/ OIDC_AUDIENCE=eventwise-api OIDC_JWKS_URI=http://127.0.0.1:9999/jwks.json node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/e2e --runInBand --verbose",
    "test:security": "npm run test:authz && npm run test:e2e",
    "test": "npm run test:contract",
    "start:jwks": "node tests/helpers/spin-jwks-render.js"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.7.9",
    "jest": "^29.7.0",
    "jose": "^6.2.12",
    "uuid": "^11.0.5",
    "yaml": "^2.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000
  }
}
